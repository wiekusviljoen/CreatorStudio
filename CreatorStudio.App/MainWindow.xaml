<Window x:Class="CreatorStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CreatorStudio" Width="1400" Height="850" Background="#0E1014" Foreground="White">
<Window.Resources>
<SolidColorBrush x:Key="Panel" Color="#171A21"/><SolidColorBrush x:Key="Panel2" Color="#1D212A"/><SolidColorBrush x:Key="Muted" Color="#9299A8"/><SolidColorBrush x:Key="Accent" Color="#7C5CFF"/>
<Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/></Style>
</Window.Resources>
<Grid>
<Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="275"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#12151B"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="CreatorStudio" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Media" Click="Media_Click"/><Button Content="Audio"/><Button Content="Text"/><Button Content="Captions"/><Button Content="Effects"/></StackPanel><Button Grid.Column="2" Content="Export" Background="{StaticResource Accent}" Click="Export_Click"/></Grid></Border>
<Grid Grid.Row="1" Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="PROJECT" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><Button Content="+ Import media" Height="42" Background="{StaticResource Accent}" Click="Import_Click"/><Button Content="Media library"/><Button Content="Audio"/><Button Content="Text &amp; titles"/><Button Content="Captions"/><Separator Margin="4,16"/><TextBlock Text="CREATOR TOOLS" Foreground="{StaticResource Muted}" FontSize="11"/><Button Content="Smart Hook"/><Button Content="Beat Sync"/><Button Content="Auto Reframe"/><Button Content="Creator Style"/></StackPanel></Border>
<Grid Grid.Column="1" Margin="14,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="54"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#090B0F" CornerRadius="12"><Grid><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="Import a video to start" FontSize="20" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="Build clips on the timeline below" Foreground="{StaticResource Muted}" Margin="0,8" HorizontalAlignment="Center"/></StackPanel></Grid></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Content="Play" Width="80" Click="Play_Click"/><Slider x:Name="SeekBar" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" ValueChanged="SeekBar_ValueChanged"/><TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Grid>
<Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Inspector" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="FileNameText" Text="No media selected" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><TextBlock Text="SELECTED CLIP" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ClipInfo" Text="No clip selected" Margin="0,5,0,8"/><StackPanel Orientation="Horizontal"><Button Content="Trim In -1s" Click="TrimIn_Click"/><Button Content="Trim Out -1s" Click="TrimOut_Click"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="Reset Trim" Click="ResetTrim_Click"/><Button Content="Split Here" Click="Split_Click"/></StackPanel><TextBlock x:Name="EditStatus" Text="Import a video to begin." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/></StackPanel></Border>
</Grid>
<Border Grid.Row="2" Background="#12151B" Padding="14,10"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions><TextBlock Text="TIMELINE" FontWeight="Bold" Foreground="{StaticResource Muted}"/><ListBox x:Name="ClipList" Grid.Row="1" Background="#101319" BorderThickness="0" SelectionChanged="ClipList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Background="#29204A" CornerRadius="5" Margin="0,3" Padding="10,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding DurationText}" HorizontalAlignment="Right" Foreground="#C9CED8"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" Text="VIDEO 1    |    AUDIO 1 - Drop music or voiceover here" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Border>
</Grid>
</Window>