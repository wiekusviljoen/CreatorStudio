<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatorStudio.Mobile.MainPage"
             BackgroundColor="#171A18">
    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="18">
            <Label Text="CreatorStudio" TextColor="White" FontSize="32" FontAttributes="Bold" />
            <Label Text="Create. Edit. Publish." TextColor="#B8C0BA" FontSize="17" />
            <Button Text="Create New Project" Clicked="OnCreateProjectClicked" BackgroundColor="#315A45" TextColor="White" CornerRadius="12" HeightRequest="54" />
            <Button Text="Import Media" Clicked="OnImportMediaClicked" BackgroundColor="#242A26" TextColor="White" CornerRadius="12" HeightRequest="54" />
            <Label x:Name="StatusLabel" Text="Ready" TextColor="#8FAF9A" FontSize="14" Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
